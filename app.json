{
  "expo": {
    "name": "mylittlegymbro",
    "slug": "mylittlegymbro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mylittlegymbro",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.mylittlegymbro"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "pan",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.mylittlegymbro"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#1A1A1A"
        }
      ],
      [
        "expo-quick-actions",
        {
          "iosActions": [
            {
              "id": "0",
              "title": "Scan Food",
              "icon": "symbol:barcode.viewfinder",
              "params": {
                "href": "/scan"
              }
            },
            {
              "id": "1",
              "title": "Quick Add",
              "icon": "symbol:plus.square",
              "params": {
                "href": "/summary/quick-add"
              }
            },
            {
              "id": "2",
              "title": "Search Food",
              "icon": "symbol:magnifyingglass",
              "params": {
                "href": "/scan/all-items"
              }
            }
          ]
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera"
        }
      ],
      "expo-quick-actions",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
